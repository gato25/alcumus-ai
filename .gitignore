__pycache__/
*.py[cod]
.venv/
venv/
.env
.auth/

# live session credentials — never commit
cookie.json
cookie.txt
state.json
*.egg-info/

# Obsidian per-machine UI state — churns on every pane move.
# The rest of .obsidian/ (app, appearance, plugins) is worth versioning.
# (**/ needed: a pattern with a slash is anchored to the repo root otherwise)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# Quartz checkout, fetched on demand by site/quartz.mjs. Not vendored: it is
# ~140 files and 16MB of framework, and only site/quartz.config.yaml is ours.
# Note: Quartz globs content with gitignore:true, so never gitignore anything
# under vault/ — ignored files are silently dropped from the published site.
.quartz-build/
